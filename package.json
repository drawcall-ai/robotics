{
  "name": "robotics-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm build && pnpm typecheck && pnpm test && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "prettier": "^3.9.0",
    "three": "0.185.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "pnpm": {
    "patchedDependencies": {
      "rclnodejs@2.2.0": "patches/rclnodejs@2.2.0.patch"
    },
    "onlyBuiltDependencies": [
      "rclnodejs",
      "webgpu"
    ]
  }
}
