<?xml version="1.0"?>
<!-- SO-101 follower, kinematics only, from TheRobotStudio's public so101_new_calib URDF (Apache-2.0).
     Joint angles in radians; LeRobot readings in degrees are close to these angles but not equal:
     the zero of each reading was set by hand. The base_link origin is about 3 mm above the table. -->
<robot name="so101">
  <link name="base_link"/>
  <link name="shoulder_link"/>
  <link name="upper_arm_link"/>
  <link name="lower_arm_link"/>
  <link name="wrist_link"/>
  <link name="gripper_link"/>
  <link name="moving_jaw_so101_v1_link"/>
  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.0388353 -8.97657e-9 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.91986" upper="1.91986" effort="2.94" velocity="4.7"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.74533" upper="1.74533" effort="2.94" velocity="4.7"/>
  </joint>
  <joint name="elbow_flex" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.69" upper="1.69" effort="2.94" velocity="4.7"/>
  </joint>
  <joint name="wrist_flex" type="revolute">
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.65806" upper="1.65806" effort="2.94" velocity="4.7"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.74385" upper="2.84121" effort="2.94" velocity="4.7"/>
  </joint>
  <joint name="gripper" type="revolute">
    <parent link="gripper_link"/>
    <child link="moving_jaw_so101_v1_link"/>
    <origin xyz="0.0202 0.0188 -0.0234" rpy="1.5708 -5.24284e-8 -1.41553e-15"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.174533" upper="1.74533" effort="2.94" velocity="4.7"/>
  </joint>
</robot>
