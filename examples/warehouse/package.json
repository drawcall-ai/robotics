{
  "name": "@drawcall/example-warehouse",
  "private": true,
  "type": "module",
  "scripts": {
    "lib": "pnpm --filter @drawcall/robotics build",
    "dev": "pnpm lib && pixi run drawcall-robotics run --viewer",
    "start": "pnpm lib && pixi run drawcall-robotics run",
    "cat": "pnpm lib && drawcall-robotics cat",
    "view": "pnpm lib && drawcall-robotics view runs/latest/bag --show /map --show /local_costmap/costmap --show /plan --show /local_plan",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@drawcall/physics": "0.16.0",
    "@drawcall/robotics": "workspace:*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3"
  }
}
