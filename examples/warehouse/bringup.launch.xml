<!-- The robot's persistent stack: ros2_control, SLAM and Nav2. A node that exits ends the launch. -->
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="params_file" default="$(dirname)/params.yaml"/>

  <node pkg="controller_manager" exec="ros2_control_node" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="robot_description" to="/robot/robot_description"/>
  </node>
  <!-- On sim time, the controller manager's first cycle waits for the simulator's clock. -->
  <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster diff_drive_controller --switch-timeout 30"/>
  <node pkg="nav2_controller" exec="controller_server" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cmd_vel" to="/diff_drive_controller/cmd_vel"/>
  </node>
  <node pkg="nav2_planner" exec="planner_server" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="nav2_behaviors" exec="behavior_server" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cmd_vel" to="/diff_drive_controller/cmd_vel"/>
  </node>
  <node pkg="nav2_bt_navigator" exec="bt_navigator" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_navigation" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <!-- A plain node rather than slam_toolbox's launch include, whose lifecycle adapter throws at shutdown. -->
  <node pkg="slam_toolbox" exec="async_slam_toolbox_node" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager" name="lifecycle_manager_slam" on_exit="shutdown">
    <param from="$(var params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
