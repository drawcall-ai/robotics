import { gltsLoader, scene } from "@drawcall/glts";
import { BoxCollider, RigidBody, Trigger } from "@drawcall/physics";
import { Evaluator, findRobot, rosPosition } from "@drawcall/robotics";
import {
  AmbientLight,
  BoxGeometry,
  Color,
  DirectionalLight,
  Fog,
  HemisphereLight,
  Mesh,
  MeshStandardMaterial,
} from "three";

const obstacles = new Set<RigidBody>();
const concrete = new MeshStandardMaterial({
  color: "#b7b9ad",
  roughness: 0.95,
});
const steel = new MeshStandardMaterial({
  color: "#465b61",
  roughness: 0.7,
  metalness: 0.3,
});
const wood = new MeshStandardMaterial({ color: "#ba8f60", roughness: 0.95 });
const orange = new MeshStandardMaterial({
  color: "#f7ab39",
  roughness: 0.45,
  metalness: 0.25,
});

/** A static box with matching collider and mesh. */
function block(
  size: [number, number, number],
  position: [number, number, number],
  material: MeshStandardMaterial,
) {
  const body = new RigidBody({ bodyType: "static" });
  body.position.set(...position);
  if (position[1] >= 0) obstacles.add(body);
  const mesh = new Mesh(new BoxGeometry(...size), material);
  mesh.castShadow = mesh.receiveShadow = true;
  body.add(new BoxCollider({ size }), mesh);
  scene.add(body);
}

function warehouse() {
  scene.background = new Color("#cbd2c9");
  scene.fog = new Fog("#cbd2c9", 20, 48);
  scene.add(
    new HemisphereLight("#ecf6ee", "#617471", 2.6),
    new AmbientLight("#ffffff", 0.35),
  );
  const sun = new DirectionalLight("#fff5dd", 3.5);
  sun.position.set(0, 12, 5);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  Object.assign(sun.shadow.camera, {
    left: -12,
    right: 12,
    top: 12,
    bottom: -12,
    near: 0.1,
    far: 40,
  });
  scene.add(sun);
  block([14, 0.2, 13], [-1, -0.1, -2], concrete);
  // Perimeter walls give the lidar returns around the loading area.
  for (const z of [-8.4, 4.4]) block([14, 1.2, 0.18], [-1, 0.6, z], concrete);
  for (const x of [-7.9, 5.9]) block([0.18, 1.2, 13], [x, 0.6, -2], concrete);
  // Two rows of racks leave the central aisle clear for the patrol.
  for (const x of [2.4, -5.6])
    for (let bay = 0; bay < 3; bay++) {
      const z = -5.6 + bay * 2.25;
      for (const dx of [-0.6, 0.6])
        for (const dz of [-0.95, 0.95])
          block([0.07, 2.5, 0.07], [x + dx, 1.25, z + dz], steel);
      for (const y of [0.16, 1.05, 1.94]) {
        block([1.3, 0.07, 2.05], [x, y, z], steel);
        for (const dz of [-0.48, 0.48])
          block([0.93, 0.5, 0.78], [x, y + 0.3, z + dz], wood);
      }
    }
  block([1.1, 0.7, 0.9], [0.5, 0.5, -7], orange);
  block([0.9, 0.6, 0.9], [-2.2, 0.45, -7.1], wood);
}

warehouse();
// The robot is an asset of its own; any robot whose base drives on the floor fits here.
scene.add(await gltsLoader.loadAsync("./robot.glts"));
const chassis = findRobot(scene).base;
// ROS (x, y) becomes Three.js (-y, height, -x). Each checkpoint scores once, in mission order.
const checkpoints = [
  [4, 0],
  [4, 3],
  [0, 3],
  [0, 0],
] as const;
let reached = 0;
let bestScore = 0;
let collisions = 0;
for (const [index, [x, y]] of checkpoints.entries()) {
  const checkpoint = new Trigger();
  checkpoint.name = `checkpoint_${index + 1}`;
  checkpoint.position.set(-y, 0.4, -x);
  checkpoint.add(new BoxCollider({ size: [0.6, 0.8, 0.6] }));
  const material = new MeshStandardMaterial({
    color: "#37a9db",
    transparent: true,
    opacity: 0.25,
    depthWrite: false,
  });
  checkpoint.add(new Mesh(new BoxGeometry(0.6, 0.8, 0.6), material));
  checkpoint.addEventListener("enter", ({ body }) => {
    if (!evaluation.active || body !== chassis || index !== reached) return;
    reached++;
    material.color.set("#45cf7c");
  });
  scene.add(checkpoint);
}
chassis.addEventListener("contactbegin", ({ otherBody }) => {
  if (evaluation.active && obstacles.has(otherBody)) collisions++;
});
const evaluation = new Evaluator({
  timeout: 180,
  // The viewer shows the SLAM map and Nav2's costmap and plans beside the robot.
  show: ["/map", "/local_costmap/costmap", "/plan", "/local_plan"],
  // Recording subscribes to what it records; a subscriber on Nav2's costmap layer and raw
  // topics crashes planner_server in this Jazzy build, so those stay out of the bag.
  recordExclude: "^/(bond|evaluation|marker)$|_costmap/.+_(layer|raw|updates)",
  metrics: { checkpoints: () => reached, collisions: () => collisions },
  success: { completedPatrol: () => reached === checkpoints.length },
  failure: {
    collision: () => collisions > 0,
    fell: () => chassis.position.y < 0,
  },
  score: () => {
    const target = checkpoints[reached];
    if (!target) return 100;
    const start = checkpoints[reached - 1] ?? [0, 0];
    const length = Math.hypot(target[0] - start[0], target[1] - start[1]);
    const { x, y } = rosPosition(chassis.position);
    const distance = Math.hypot(target[0] - x, target[1] - y);
    const progress = Math.min(0.99, Math.max(0, 1 - distance / length));
    bestScore = Math.max(
      bestScore,
      (100 * (reached + progress)) / checkpoints.length,
    );
    return bestScore;
  },
});
scene.add(evaluation);
