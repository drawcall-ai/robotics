{
  "name": "@drawcall/example-so101",
  "private": true,
  "dependencies": {
    "@drawcall/physics": "0.12.0",
    "@drawcall/robotics": "workspace:*",
    "sharp": "^0.35.4",
    "three": "^0.185.1"
  },
  "type": "module",
  "scripts": {
    "lib": "pnpm --filter @drawcall/robotics build",
    "dev": "pnpm lib && pixi run launch viewer:=true",
    "launch": "pnpm lib && pixi run launch",
    "episodes": "pnpm lib && pixi run drawcall-robotics episodes bringup.launch.xml",
    "record": "pnpm lib && pixi run launch record:=true",
    "replay": "pnpm lib && drawcall-robotics view",
    "typecheck": "tsc --noEmit",
    "results": "pnpm lib && drawcall-robotics results"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.3"
  },
  "assetDependencies": {
    "wood-01": "^1.0.0",
    "wood-02": "^1.0.1",
    "stark-white-brutalist-digital-sky": "^1.0.0"
  }
}
