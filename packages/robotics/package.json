{
  "name": "@drawcall/robotics",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@drawcall/physics-rapier": "0.4.0",
    "jpeg-js": "^0.4.4",
    "roslib": "^2.1.0"
  },
  "peerDependencies": {
    "@drawcall/physics": "^0.4.0",
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@drawcall/physics": "0.4.0",
    "@types/node": "^26.6.0",
    "@types/send": "^1.2.1"
  },
  "description": "ROS 2 simulation for Three.js and Drawcall physics: sensors, ros2_control bindings, URDF export and a headless simulator node.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "drawcall-robotics": "./dist/cli/main.js"
  },
  "optionalDependencies": {
    "@mcap/core": "2.2.2",
    "rclnodejs": "2.2.0",
    "send": "^1.2.1",
    "webgpu": "^0.6.1"
  },
  "engines": {
    "node": ">=24.2"
  }
}
