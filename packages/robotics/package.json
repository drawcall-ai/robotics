{
  "name": "@drawcall/robotics",
  "version": "0.1.0",
  "type": "module",
  "description": "ROS 2 simulation for Three.js and Drawcall physics: sensors, ros2_control bindings, URDF export and a headless simulator node.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "drawcall-robotics": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "launch",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@drawcall/physics-mujoco": "0.16.0",
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg2-serialization": "^3.1.2",
    "@mcap/core": "2.2.2",
    "@mcap/support": "^1.1.0",
    "commander": "^15.0.0",
    "jpeg-js": "^0.4.4",
    "open": "^11.0.4",
    "roslib": "^2.1.0",
    "send": "^1.2.1",
    "tar": "^7.5.22"
  },
  "optionalDependencies": {
    "rclnodejs": "2.2.0",
    "webgpu": "^0.6.1"
  },
  "peerDependencies": {
    "@drawcall/physics": "^0.16.0",
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@drawcall/physics": "0.16.0",
    "@types/node": "^26.6.0",
    "@types/send": "^1.2.1"
  },
  "engines": {
    "node": ">=24.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drawcall-ai/robotics.git",
    "directory": "packages/robotics"
  },
  "homepage": "https://github.com/drawcall-ai/robotics#readme",
  "bugs": {
    "url": "https://github.com/drawcall-ai/robotics/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
